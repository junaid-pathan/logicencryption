# TTLock-protected netlist
INPUT(LINE1)
INPUT(LINE2)
INPUT(ttlock_pi_2)
INPUT(ttlock_pi_3)
INPUT(ttlock_pi_4)
INPUT(ttlock_pi_5)
INPUT(ttlock_pi_6)
INPUT(ttlock_pi_7)
INPUT(ttlock_pi_8)
INPUT(ttlock_pi_9)
INPUT(ttlock_pi_10)
INPUT(ttlock_pi_11)
INPUT(ttlock_pi_12)
INPUT(ttlock_pi_13)
INPUT(ttlock_pi_14)
INPUT(ttlock_pi_15)
INPUT(keyinput0)
INPUT(keyinput1)
INPUT(keyinput2)
INPUT(keyinput3)
INPUT(keyinput4)
INPUT(keyinput5)
INPUT(keyinput6)
INPUT(keyinput7)
INPUT(keyinput8)
INPUT(keyinput9)
INPUT(keyinput10)
INPUT(keyinput11)
INPUT(keyinput12)
INPUT(keyinput13)
INPUT(keyinput14)
INPUT(keyinput15)

OUTPUT(OUTP_REG)
OUTPUT(OVERFLW_REG)

OVERFLW_REG = DFF(U34)
STATO_REG_2_ = DFF(U45)
STATO_REG_1_ = DFF(U36)
STATO_REG_0_ = DFF(U35)
U34 = AND(STATO_REG_1_, U38, STATO_REG_0_)
U35 = NAND(U68, U67, U66, U65)
U36 = NAND(U57, U55, U56)
U37 = OR(LINE2, LINE1)
U38 = NOT(STATO_REG_2_)
U39 = NOT(STATO_REG_1_)
U40 = NOT(LINE2)
U41 = NOT(LINE1)
U42 = NOT(STATO_REG_0_)
U43 = NAND(STATO_REG_1_, U42)
U44 = NAND(U73, U72)
U45 = NAND(U60, U59)
U46 = NAND(U70, U69)
U47 = NAND(LINE1, LINE2)
U48 = NAND(STATO_REG_2_, U43)
U49 = NOT(U37)
U50 = NAND(U49, U42)
U51 = NOT(U47)
U52 = NOT(U43)
U53 = NAND(U47, U43)
U54 = NAND(STATO_REG_2_, U47)
U55 = NAND(STATO_REG_0_, U39, U47)
U56 = NAND(U52, U54)
U57 = NAND(U62, U61, STATO_REG_2_)
U58 = NOT(U48)
U59 = NAND(U53, U38)
U60 = NAND(U50, U39, STATO_REG_2_)
U61 = NAND(STATO_REG_1_, U49)
U62 = NAND(U37, U42)
U63 = NAND(STATO_REG_0_, U47)
U64 = NAND(U51, U42)
U65 = NAND(U64, U63, U39, U38)
U66 = NAND(U43, U37, STATO_REG_2_)
U67 = NAND(U34, U47)
U68 = NAND(U51, U52)
U69 = NAND(LINE1, U40)
U70 = NAND(LINE2, U41)
U71 = NOT(U46)
U72 = NAND(U58, U71)
U73 = NAND(U46, U48)
ttlock_mlc_inv2 = NOT(ttlock_pi_2)
ttlock_mlc_inv3 = NOT(ttlock_pi_3)
ttlock_mlc_inv6 = NOT(ttlock_pi_6)
ttlock_mlc_inv7 = NOT(ttlock_pi_7)
ttlock_mlc_inv11 = NOT(ttlock_pi_11)
ttlock_mlc_inv12 = NOT(ttlock_pi_12)
ttlock_mlc_inv13 = NOT(ttlock_pi_13)
ttlock_mlc_inv15 = NOT(ttlock_pi_15)
ttlock_mlc_and_s0_g0 = AND(LINE2, LINE1)
ttlock_mlc_and_s0_g1 = AND(ttlock_mlc_inv2, ttlock_mlc_inv3)
ttlock_mlc_and_s0_g2 = AND(ttlock_pi_4, ttlock_pi_5)
ttlock_mlc_and_s0_g3 = AND(ttlock_mlc_inv6, ttlock_mlc_inv7)
ttlock_mlc_and_s0_g4 = AND(ttlock_pi_8, ttlock_pi_9)
ttlock_mlc_and_s0_g5 = AND(ttlock_pi_10, ttlock_mlc_inv11)
ttlock_mlc_and_s0_g6 = AND(ttlock_mlc_inv12, ttlock_mlc_inv13)
ttlock_mlc_and_s0_g7 = AND(ttlock_pi_14, ttlock_mlc_inv15)
ttlock_mlc_and_s1_g0 = AND(ttlock_mlc_and_s0_g0, ttlock_mlc_and_s0_g1)
ttlock_mlc_and_s1_g1 = AND(ttlock_mlc_and_s0_g2, ttlock_mlc_and_s0_g3)
ttlock_mlc_and_s1_g2 = AND(ttlock_mlc_and_s0_g4, ttlock_mlc_and_s0_g5)
ttlock_mlc_and_s1_g3 = AND(ttlock_mlc_and_s0_g6, ttlock_mlc_and_s0_g7)
ttlock_mlc_and_s2_g0 = AND(ttlock_mlc_and_s1_g0, ttlock_mlc_and_s1_g1)
ttlock_mlc_and_s2_g1 = AND(ttlock_mlc_and_s1_g2, ttlock_mlc_and_s1_g3)
ttlock_mlc_and_s3_g0 = AND(ttlock_mlc_and_s2_g0, ttlock_mlc_and_s2_g1)
ttlock_mlc_xor = XOR(OUTP_REG_orig, ttlock_mlc_and_s3_g0)
ttlock_xnor0 = XNOR(LINE2, keyinput0)
ttlock_xnor1 = XNOR(LINE1, keyinput1)
ttlock_xnor2 = XNOR(ttlock_pi_2, keyinput2)
ttlock_xnor3 = XNOR(ttlock_pi_3, keyinput3)
ttlock_xnor4 = XNOR(ttlock_pi_4, keyinput4)
ttlock_xnor5 = XNOR(ttlock_pi_5, keyinput5)
ttlock_xnor6 = XNOR(ttlock_pi_6, keyinput6)
ttlock_xnor7 = XNOR(ttlock_pi_7, keyinput7)
ttlock_xnor8 = XNOR(ttlock_pi_8, keyinput8)
ttlock_xnor9 = XNOR(ttlock_pi_9, keyinput9)
ttlock_xnor10 = XNOR(ttlock_pi_10, keyinput10)
ttlock_xnor11 = XNOR(ttlock_pi_11, keyinput11)
ttlock_xnor12 = XNOR(ttlock_pi_12, keyinput12)
ttlock_xnor13 = XNOR(ttlock_pi_13, keyinput13)
ttlock_xnor14 = XNOR(ttlock_pi_14, keyinput14)
ttlock_xnor15 = XNOR(ttlock_pi_15, keyinput15)
ttlock_cmp_and_s0_g0 = AND(ttlock_xnor0, ttlock_xnor1)
ttlock_cmp_and_s0_g1 = AND(ttlock_xnor2, ttlock_xnor3)
ttlock_cmp_and_s0_g2 = AND(ttlock_xnor4, ttlock_xnor5)
ttlock_cmp_and_s0_g3 = AND(ttlock_xnor6, ttlock_xnor7)
ttlock_cmp_and_s0_g4 = AND(ttlock_xnor8, ttlock_xnor9)
ttlock_cmp_and_s0_g5 = AND(ttlock_xnor10, ttlock_xnor11)
ttlock_cmp_and_s0_g6 = AND(ttlock_xnor12, ttlock_xnor13)
ttlock_cmp_and_s0_g7 = AND(ttlock_xnor14, ttlock_xnor15)
ttlock_cmp_and_s1_g0 = AND(ttlock_cmp_and_s0_g0, ttlock_cmp_and_s0_g1)
ttlock_cmp_and_s1_g1 = AND(ttlock_cmp_and_s0_g2, ttlock_cmp_and_s0_g3)
ttlock_cmp_and_s1_g2 = AND(ttlock_cmp_and_s0_g4, ttlock_cmp_and_s0_g5)
ttlock_cmp_and_s1_g3 = AND(ttlock_cmp_and_s0_g6, ttlock_cmp_and_s0_g7)
ttlock_cmp_and_s2_g0 = AND(ttlock_cmp_and_s1_g0, ttlock_cmp_and_s1_g1)
ttlock_cmp_and_s2_g1 = AND(ttlock_cmp_and_s1_g2, ttlock_cmp_and_s1_g3)
ttlock_cmp_and_s3_g0 = AND(ttlock_cmp_and_s2_g0, ttlock_cmp_and_s2_g1)
ttlock_final_xor = XOR(ttlock_mlc_xor, ttlock_cmp_and_s3_g0)
OUTP_REG_orig = DFF(U44)
OUTP_REG = BUF(ttlock_final_xor)
