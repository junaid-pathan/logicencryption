# TTLock-protected netlist
INPUT(G0)
INPUT(G1)
INPUT(G2)
INPUT(G3)
INPUT(ttlock_pi_4)
INPUT(ttlock_pi_5)
INPUT(ttlock_pi_6)
INPUT(ttlock_pi_7)
INPUT(ttlock_pi_8)
INPUT(ttlock_pi_9)
INPUT(ttlock_pi_10)
INPUT(ttlock_pi_11)
INPUT(ttlock_pi_12)
INPUT(ttlock_pi_13)
INPUT(ttlock_pi_14)
INPUT(ttlock_pi_15)
INPUT(keyinput0)
INPUT(keyinput1)
INPUT(keyinput2)
INPUT(keyinput3)
INPUT(keyinput4)
INPUT(keyinput5)
INPUT(keyinput6)
INPUT(keyinput7)
INPUT(keyinput8)
INPUT(keyinput9)
INPUT(keyinput10)
INPUT(keyinput11)
INPUT(keyinput12)
INPUT(keyinput13)
INPUT(keyinput14)
INPUT(keyinput15)

OUTPUT(G17)

G5 = DFF(G10)
G6 = DFF(G11)
G7 = DFF(G13)
G14 = NOT(G0)
G8 = AND(G14, G6)
G15 = OR(G12, G8)
G16 = OR(G3, G8)
G9 = NAND(G16, G15)
G10 = NOR(G14, G11)
G11 = NOR(G5, G9)
G12 = NOR(G1, G7)
G13 = NOR(G2, G12)
ttlock_mlc_inv0 = NOT(G3)
ttlock_mlc_inv1 = NOT(G1)
ttlock_mlc_inv4 = NOT(ttlock_pi_4)
ttlock_mlc_inv5 = NOT(ttlock_pi_5)
ttlock_mlc_inv9 = NOT(ttlock_pi_9)
ttlock_mlc_inv10 = NOT(ttlock_pi_10)
ttlock_mlc_inv11 = NOT(ttlock_pi_11)
ttlock_mlc_inv13 = NOT(ttlock_pi_13)
ttlock_mlc_inv14 = NOT(ttlock_pi_14)
ttlock_mlc_inv15 = NOT(ttlock_pi_15)
ttlock_mlc_and_s0_g0 = AND(ttlock_mlc_inv0, ttlock_mlc_inv1)
ttlock_mlc_and_s0_g1 = AND(G2, G0)
ttlock_mlc_and_s0_g2 = AND(ttlock_mlc_inv4, ttlock_mlc_inv5)
ttlock_mlc_and_s0_g3 = AND(ttlock_pi_6, ttlock_pi_7)
ttlock_mlc_and_s0_g4 = AND(ttlock_pi_8, ttlock_mlc_inv9)
ttlock_mlc_and_s0_g5 = AND(ttlock_mlc_inv10, ttlock_mlc_inv11)
ttlock_mlc_and_s0_g6 = AND(ttlock_pi_12, ttlock_mlc_inv13)
ttlock_mlc_and_s0_g7 = AND(ttlock_mlc_inv14, ttlock_mlc_inv15)
ttlock_mlc_and_s1_g0 = AND(ttlock_mlc_and_s0_g0, ttlock_mlc_and_s0_g1)
ttlock_mlc_and_s1_g1 = AND(ttlock_mlc_and_s0_g2, ttlock_mlc_and_s0_g3)
ttlock_mlc_and_s1_g2 = AND(ttlock_mlc_and_s0_g4, ttlock_mlc_and_s0_g5)
ttlock_mlc_and_s1_g3 = AND(ttlock_mlc_and_s0_g6, ttlock_mlc_and_s0_g7)
ttlock_mlc_and_s2_g0 = AND(ttlock_mlc_and_s1_g0, ttlock_mlc_and_s1_g1)
ttlock_mlc_and_s2_g1 = AND(ttlock_mlc_and_s1_g2, ttlock_mlc_and_s1_g3)
ttlock_mlc_and_s3_g0 = AND(ttlock_mlc_and_s2_g0, ttlock_mlc_and_s2_g1)
ttlock_mlc_xor = XOR(G17_orig, ttlock_mlc_and_s3_g0)
ttlock_xnor0 = XNOR(G3, keyinput0)
ttlock_xnor1 = XNOR(G1, keyinput1)
ttlock_xnor2 = XNOR(G2, keyinput2)
ttlock_xnor3 = XNOR(G0, keyinput3)
ttlock_xnor4 = XNOR(ttlock_pi_4, keyinput4)
ttlock_xnor5 = XNOR(ttlock_pi_5, keyinput5)
ttlock_xnor6 = XNOR(ttlock_pi_6, keyinput6)
ttlock_xnor7 = XNOR(ttlock_pi_7, keyinput7)
ttlock_xnor8 = XNOR(ttlock_pi_8, keyinput8)
ttlock_xnor9 = XNOR(ttlock_pi_9, keyinput9)
ttlock_xnor10 = XNOR(ttlock_pi_10, keyinput10)
ttlock_xnor11 = XNOR(ttlock_pi_11, keyinput11)
ttlock_xnor12 = XNOR(ttlock_pi_12, keyinput12)
ttlock_xnor13 = XNOR(ttlock_pi_13, keyinput13)
ttlock_xnor14 = XNOR(ttlock_pi_14, keyinput14)
ttlock_xnor15 = XNOR(ttlock_pi_15, keyinput15)
ttlock_cmp_and_s0_g0 = AND(ttlock_xnor0, ttlock_xnor1)
ttlock_cmp_and_s0_g1 = AND(ttlock_xnor2, ttlock_xnor3)
ttlock_cmp_and_s0_g2 = AND(ttlock_xnor4, ttlock_xnor5)
ttlock_cmp_and_s0_g3 = AND(ttlock_xnor6, ttlock_xnor7)
ttlock_cmp_and_s0_g4 = AND(ttlock_xnor8, ttlock_xnor9)
ttlock_cmp_and_s0_g5 = AND(ttlock_xnor10, ttlock_xnor11)
ttlock_cmp_and_s0_g6 = AND(ttlock_xnor12, ttlock_xnor13)
ttlock_cmp_and_s0_g7 = AND(ttlock_xnor14, ttlock_xnor15)
ttlock_cmp_and_s1_g0 = AND(ttlock_cmp_and_s0_g0, ttlock_cmp_and_s0_g1)
ttlock_cmp_and_s1_g1 = AND(ttlock_cmp_and_s0_g2, ttlock_cmp_and_s0_g3)
ttlock_cmp_and_s1_g2 = AND(ttlock_cmp_and_s0_g4, ttlock_cmp_and_s0_g5)
ttlock_cmp_and_s1_g3 = AND(ttlock_cmp_and_s0_g6, ttlock_cmp_and_s0_g7)
ttlock_cmp_and_s2_g0 = AND(ttlock_cmp_and_s1_g0, ttlock_cmp_and_s1_g1)
ttlock_cmp_and_s2_g1 = AND(ttlock_cmp_and_s1_g2, ttlock_cmp_and_s1_g3)
ttlock_cmp_and_s3_g0 = AND(ttlock_cmp_and_s2_g0, ttlock_cmp_and_s2_g1)
ttlock_final_xor = XOR(ttlock_mlc_xor, ttlock_cmp_and_s3_g0)
G17_orig = NOT(G11)
G17 = BUF(ttlock_final_xor)
