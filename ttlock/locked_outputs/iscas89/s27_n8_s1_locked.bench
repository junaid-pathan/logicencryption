# TTLock-protected netlist
INPUT(G0)
INPUT(G1)
INPUT(G2)
INPUT(G3)
INPUT(ttlock_pi_4)
INPUT(ttlock_pi_5)
INPUT(ttlock_pi_6)
INPUT(ttlock_pi_7)
INPUT(keyinput0)
INPUT(keyinput1)
INPUT(keyinput2)
INPUT(keyinput3)
INPUT(keyinput4)
INPUT(keyinput5)
INPUT(keyinput6)
INPUT(keyinput7)

OUTPUT(G17)

G5 = DFF(G10)
G6 = DFF(G11)
G7 = DFF(G13)
G14 = NOT(G0)
G8 = AND(G14, G6)
G15 = OR(G12, G8)
G16 = OR(G3, G8)
G9 = NAND(G16, G15)
G10 = NOR(G14, G11)
G11 = NOR(G5, G9)
G12 = NOR(G1, G7)
G13 = NOR(G2, G12)
ttlock_mlc_inv4 = NOT(ttlock_pi_4)
ttlock_mlc_inv5 = NOT(ttlock_pi_5)
ttlock_mlc_inv7 = NOT(ttlock_pi_7)
ttlock_mlc_and_s0_g0 = AND(G1, G2)
ttlock_mlc_and_s0_g1 = AND(G0, G3)
ttlock_mlc_and_s0_g2 = AND(ttlock_mlc_inv4, ttlock_mlc_inv5)
ttlock_mlc_and_s0_g3 = AND(ttlock_pi_6, ttlock_mlc_inv7)
ttlock_mlc_and_s1_g0 = AND(ttlock_mlc_and_s0_g0, ttlock_mlc_and_s0_g1)
ttlock_mlc_and_s1_g1 = AND(ttlock_mlc_and_s0_g2, ttlock_mlc_and_s0_g3)
ttlock_mlc_and_s2_g0 = AND(ttlock_mlc_and_s1_g0, ttlock_mlc_and_s1_g1)
ttlock_mlc_xor = XOR(G17_orig, ttlock_mlc_and_s2_g0)
ttlock_xnor0 = XNOR(G1, keyinput0)
ttlock_xnor1 = XNOR(G2, keyinput1)
ttlock_xnor2 = XNOR(G0, keyinput2)
ttlock_xnor3 = XNOR(G3, keyinput3)
ttlock_xnor4 = XNOR(ttlock_pi_4, keyinput4)
ttlock_xnor5 = XNOR(ttlock_pi_5, keyinput5)
ttlock_xnor6 = XNOR(ttlock_pi_6, keyinput6)
ttlock_xnor7 = XNOR(ttlock_pi_7, keyinput7)
ttlock_cmp_and_s0_g0 = AND(ttlock_xnor0, ttlock_xnor1)
ttlock_cmp_and_s0_g1 = AND(ttlock_xnor2, ttlock_xnor3)
ttlock_cmp_and_s0_g2 = AND(ttlock_xnor4, ttlock_xnor5)
ttlock_cmp_and_s0_g3 = AND(ttlock_xnor6, ttlock_xnor7)
ttlock_cmp_and_s1_g0 = AND(ttlock_cmp_and_s0_g0, ttlock_cmp_and_s0_g1)
ttlock_cmp_and_s1_g1 = AND(ttlock_cmp_and_s0_g2, ttlock_cmp_and_s0_g3)
ttlock_cmp_and_s2_g0 = AND(ttlock_cmp_and_s1_g0, ttlock_cmp_and_s1_g1)
ttlock_final_xor = XOR(ttlock_mlc_xor, ttlock_cmp_and_s2_g0)
G17_orig = NOT(G11)
G17 = BUF(ttlock_final_xor)
