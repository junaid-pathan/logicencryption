# TTLock-protected netlist
INPUT(1)
INPUT(2)
INPUT(3)
INPUT(6)
INPUT(7)
INPUT(keyinput0)
INPUT(keyinput1)
INPUT(keyinput2)
INPUT(keyinput3)

OUTPUT(22)
OUTPUT(23)

10 = NAND(1, 3)
11 = NAND(3, 6)
16 = NAND(2, 11)
19 = NAND(11, 7)
23 = NAND(16, 19)
ttlock_mlc_and_s0_g0 = AND(6, 1)
ttlock_mlc_and_s0_g1 = AND(2, 3)
ttlock_mlc_and_s1_g0 = AND(ttlock_mlc_and_s0_g0, ttlock_mlc_and_s0_g1)
ttlock_mlc_xor = XOR(22_orig, ttlock_mlc_and_s1_g0)
ttlock_xnor0 = XNOR(6, keyinput0)
ttlock_xnor1 = XNOR(1, keyinput1)
ttlock_xnor2 = XNOR(2, keyinput2)
ttlock_xnor3 = XNOR(3, keyinput3)
ttlock_cmp_and_s0_g0 = AND(ttlock_xnor0, ttlock_xnor1)
ttlock_cmp_and_s0_g1 = AND(ttlock_xnor2, ttlock_xnor3)
ttlock_cmp_and_s1_g0 = AND(ttlock_cmp_and_s0_g0, ttlock_cmp_and_s0_g1)
ttlock_final_xor = XOR(ttlock_mlc_xor, ttlock_cmp_and_s1_g0)
22_orig = NAND(10, 16)
22 = BUF(ttlock_final_xor)
