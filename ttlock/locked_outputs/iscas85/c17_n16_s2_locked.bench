ttlock_mlc_and_s3_g0 = AND(ttlock_mlc_and_s2_g0, ttlock_mlc_and_s2_g1)
ttlock_mlc_xor = XOR(22_orig, ttlock_mlc_and_s3_g0)
ttlock_xnor0 = XNOR(6, keyinput0)
ttlock_xnor1 = XNOR(2, keyinput1)
ttlock_xnor2 = XNOR(1, keyinput2)
ttlock_xnor3 = XNOR(3, keyinput3)
ttlock_xnor4 = XNOR(7, keyinput4)
