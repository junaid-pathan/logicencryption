10 = NAND(1, 3)
11 = NAND(3, 6)
16 = NAND(2, 11)
19 = NAND(11, 7)
23 = NAND(16, 19)
ttlock_mlc_inv0 = NOT(6)
ttlock_mlc_inv3 = NOT(3)
ttlock_mlc_inv4 = NOT(7)
ttlock_mlc_inv5 = NOT(ttlock_pi_5)
ttlock_mlc_inv11 = NOT(ttlock_pi_11)
ttlock_mlc_inv12 = NOT(ttlock_pi_12)
ttlock_mlc_and_s0_g0 = AND(ttlock_mlc_inv0, 2)
ttlock_mlc_and_s0_g1 = AND(1, ttlock_mlc_inv3)
ttlock_mlc_and_s0_g2 = AND(ttlock_mlc_inv4, ttlock_mlc_inv5)
ttlock_mlc_and_s0_g3 = AND(ttlock_pi_6, ttlock_pi_7)
ttlock_mlc_and_s0_g4 = AND(ttlock_pi_8, ttlock_pi_9)
