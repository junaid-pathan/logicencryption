ttlock_xnor7 = XNOR(ttlock_pi_7, keyinput7)
ttlock_xnor8 = XNOR(ttlock_pi_8, keyinput8)
ttlock_xnor9 = XNOR(ttlock_pi_9, keyinput9)
ttlock_xnor10 = XNOR(ttlock_pi_10, keyinput10)
ttlock_xnor11 = XNOR(ttlock_pi_11, keyinput11)
ttlock_xnor12 = XNOR(ttlock_pi_12, keyinput12)
ttlock_xnor13 = XNOR(ttlock_pi_13, keyinput13)
ttlock_xnor14 = XNOR(ttlock_pi_14, keyinput14)
ttlock_xnor15 = XNOR(ttlock_pi_15, keyinput15)
ttlock_cmp_and_s0_g0 = AND(ttlock_xnor0, ttlock_xnor1)
ttlock_cmp_and_s0_g1 = AND(ttlock_xnor2, ttlock_xnor3)
ttlock_cmp_and_s0_g2 = AND(ttlock_xnor4, ttlock_xnor5)
